# ============================================================
# NashAlert Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Your Supabase project URL — found in Project Settings > API > Project URL
SUPABASE_URL=

# Your Supabase anon/public key — found in Project Settings > API > Project API keys > anon public
# Safe to use in client-side code; Row Level Security governs access.
SUPABASE_ANON_KEY=

# Your Supabase service role key — found in Project Settings > API > Project API keys > service_role
# DANGER: This key bypasses Row Level Security. Use only in backend ingestion scripts, never in client code.
SUPABASE_SERVICE_KEY=

# Port the Express server listens on. Defaults to 3000 if not set.
PORT=3000

# Set to true to disable cache staleness checks and always serve from the precomputed
# recurrence_cache regardless of age. Use only for local demo/screenshot runs — never
# set this in a production or Render deployment.
BYPASS_CACHE_STALENESS=false
