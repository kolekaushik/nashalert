# Normalize line endings to LF in the repository on all platforms.
# Windows checkouts will still use CRLF locally via core.autocrlf,
# but the repo itself stores LF — preventing cross-platform diff noise.
* text=auto eol=lf

# Explicitly binary — never mangle these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
