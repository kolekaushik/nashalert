# ============================================================
# NashAlert — Environment Variables
# ============================================================
# Copy this file to .env in each component directory and fill
# in your real values. NEVER commit .env files to Git.
#
# This file documents every environment variable used across
# all three components: backend, dashboard, and mobile.
# ============================================================


# ------------------------------------------------------------
# BACKEND (backend/.env)
# Node.js / Express server
# ------------------------------------------------------------

# Port the Express server listens on.
# Render will inject its own PORT in production; this default
# is used in local development.
PORT=3001

# Node environment. Set to "production" on Render.
NODE_ENV=development

# Supabase project URL — found in Supabase dashboard under
# Project Settings > API > Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — found in Supabase dashboard under
# Project Settings > API > service_role key.
# This key bypasses Row Level Security. NEVER expose it to the
# client. Backend use only.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Nashville Metro Open Data (Socrata) app token.
# Optional but reduces rate-limiting when fetching 311 data
# from data.nashville.gov. Register at dev.socrata.com.
NASHVILLE_OPEN_DATA_APP_TOKEN=your-socrata-app-token-here


# ------------------------------------------------------------
# DASHBOARD (dashboard/.env)
# React / Vite web app
# Vite exposes only variables prefixed with VITE_ to the browser.
# ------------------------------------------------------------

# Supabase project URL — same value as SUPABASE_URL above.
# Vite prefix required so the browser bundle can access it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — found in Supabase dashboard under
# Project Settings > API > anon public key.
# This key is safe to expose in the browser; Row Level Security
# governs what it can access.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Mapbox GL JS access token — found in your Mapbox account
# under Tokens. The dashboard uses the dark-v11 base style.
# Create a token at account.mapbox.com.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token-here

# Base URL of the Express backend.
# In development: http://localhost:3001
# In production: your Render service URL (e.g. https://nashalert-api.onrender.com)
VITE_BACKEND_URL=http://localhost:3001


# ------------------------------------------------------------
# MOBILE (mobile/.env)
# Expo / React Native app
# Expo exposes only variables prefixed with EXPO_PUBLIC_ to
# the app bundle. Never put secrets in EXPO_PUBLIC_ variables.
# ------------------------------------------------------------

# Supabase project URL — same value as above.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — same value as VITE_SUPABASE_ANON_KEY.
# Safe to embed in the mobile bundle.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Base URL of the Express backend, reachable from the device.
# In development: use your machine's LAN IP (not localhost) so
# a physical device or emulator can reach it, e.g.:
#   http://192.168.1.x:3001
# In production: your Render service URL.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.x:3001

# Google Maps API key for react-native-maps (Google Maps provider).
# Enable the Maps SDK for Android and Maps SDK for iOS in
# Google Cloud Console. Restrict the key to your app bundle IDs
# before going to production.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
