# NashAlert Dashboard — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# Mapbox public token — get from https://account.mapbox.com/access-tokens/
# Required for the map to load. Use a public token (pk.*), not a secret token.
VITE_MAPBOX_TOKEN=

# Backend API base URL — the running NashAlert Express backend
# Development: http://localhost:3000
# Production (Render): https://your-app.onrender.com
VITE_API_BASE_URL=http://localhost:3000
